# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Llave secreta (sb_secret_…) o la service_role legacy. NUNCA en el frontend.
SUPABASE_SECRET_KEY=

# App
# URL pública (para webhooks). En Vercel se deduce sola; en local usa un túnel (ngrok / cloudflared).
APP_URL=
# Secreto que viaja en la URL de los webhooks (genera uno: openssl rand -hex 24)
WEBHOOK_SECRET=
# Clave del panel (Basic Auth). Vacío = panel abierto.
DASHBOARD_PASSWORD=

# Selección de proveedores por paso
# sandbox = datos precargados en Supabase (tabla sandbox_profiles)
PROVIDER_LINKEDIN=sandbox        # sandbox | serper | hybrid (real + datos de prueba)
PROVIDER_ENRICHMENT=sandbox      # sandbox | signalhire
PROVIDER_VOICE=simulated         # simulated | vapi
PROVIDER_CALENDAR=sandbox        # sandbox | google
PROVIDER_EMAIL=sandbox           # sandbox | gmail | smtp

# Paso 1 · LinkedIn (búsqueda web, sin scraping)
SERPER_API_KEY=
# Opcional: Claude desambigua homónimos entre los candidatos
ANTHROPIC_API_KEY=
# Correo profesional por nombre + dominio de la empresa (solo si falta el correo)
HUNTER_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Paso 2 · Enriquecimiento
SIGNALHIRE_API_KEY=

# Paso 3 · Voz (Vapi)
VAPI_API_KEY=
# Número desde el que se llama (para llamar a Colombia: importa un número de Twilio en Vapi)
VAPI_PHONE_NUMBER_ID=
# Clave pública: prueba del agente desde el navegador (pantalla Voces)
VAPI_PUBLIC_KEY=
# Solo estos números (separados por coma) reciben llamada real; el resto se simula. Vacío = todos.
VOICE_LIVE_NUMBERS=
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o
VAPI_VOICE_PROVIDER=azure
VAPI_VOICE_ID=es-CO-SalomeNeural

# Paso 4 · Google Calendar (invitación + Meet) y Gmail (correos)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Se obtiene con: node scripts/google-refresh-token.mjs
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Gmail por SMTP (PROVIDER_EMAIL=smtp): cuenta y contraseña de aplicación
SMTP_USER=
SMTP_PASS=
# Enlace de Meet fijo cuando el calendario no es Google
MEET_ROOM_URL=

# Firma del correo de seguimiento (debe ser la misma cuenta de Google conectada)
SENDER_NAME=
SENDER_TITLE=
SENDER_PHONE=
SENDER_EMAIL=

# Negocio
COMPANY_NAME=Attack
BRAND_NAME=Lenovo
EVENT_NAME=ANDICOM 2026
AGENT_NAME=Sofía
MEETING_MINUTES=15
BUSINESS_TZ=America/Bogota
BUSINESS_TZ_OFFSET=-05:00
BUSINESS_HOUR_START=9
BUSINESS_HOUR_END=17
